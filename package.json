{
  "name": "@mikholand/ui",
  "version": "0.1.0",
  "description": "mikholand UI — плотная дизайн-система для рабочих интерфейсов и Telegram Mini App: токены, CSS-компоненты, поведение без зависимостей и React-обёртки",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikholand/ui.git"
  },
  "homepage": "https://github.com/mikholand/ui#readme",
  "keywords": [
    "design-system",
    "ui-kit",
    "react",
    "css",
    "telegram-mini-app"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "tokens/tokens.json",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/mikholand-ui.global.js",
  "jsdelivr": "./dist/mikholand-ui.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./components.css": "./dist/components.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./tokens/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run clean && npm run tokens && tsup && node scripts/build-css.mjs",
    "typecheck": "npm run tokens && tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "preview": "npm run build && npx --yes serve -l 3200 .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
